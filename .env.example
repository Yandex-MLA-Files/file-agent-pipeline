# ---------------------------------------------------------------------------
# LLM backend (used by the RAG question-answering pipeline)
# LLM_BACKEND selects which client create_llm_client() builds: "yandex" or "local".
# ---------------------------------------------------------------------------
LLM_BACKEND=yandex

# RAG orchestration mode:
#   standard - one retrieval followed by answer generation (default);
#   agentic  - question routing, context grading, and bounded query rewriting.
RAG_MODE=standard
RAG_MAX_RETRIES=2

# Yandex Cloud (OpenAI-compatible endpoint)
YANDEX_API_KEY=your_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_MODEL=qwen3.6-35b-a3b
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Local OpenAI-compatible server (e.g. vLLM / llama.cpp / Ollama)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ---------------------------------------------------------------------------
# VLM (describes figures/diagrams in PDFs so they become searchable text).
# VLM_BACKEND selects the backend:
#   off     - disabled (default); parsing stays fully offline.
#   smolvlm - local SmolVLM-256M via transformers: no server, no API key,
#             CPU-friendly, ~500 MB one-time download. Cheapest working option.
#   openai  - any OpenAI-compatible vision endpoint (best quality):
#             local Ollama (VLM_BASE_URL=http://localhost:11434/v1,
#             VLM_MODEL=qwen2.5-vl:7b) or a cloud API.
# Cost controls: at most VLM_MAX_FIGURES largest figures per document are
# described; figures smaller than VLM_MIN_FIGURE_AREA (PDF points^2) are skipped.
# ---------------------------------------------------------------------------
VLM_BACKEND=off
VLM_LOCAL_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=qwen2.5-vl:7b
VLM_API_KEY=dummy
VLM_MAX_FIGURES=8
VLM_MIN_FIGURE_AREA=5000

# ---------------------------------------------------------------------------
# OCR (used by the parser for scanned/image PDF pages; auto-triggered per page).
# OCR_ENGINE: "easyocr" (default, reads Cyrillic + Latin, accurate but slower on
# CPU) or "rapidocr" (faster, offline, Latin/CJK only).
# OCR_LANGS: language codes for EasyOCR (default "ru,en").
# ---------------------------------------------------------------------------
OCR_ENGINE=easyocr
OCR_LANGS=ru,en
