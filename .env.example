# ---------------------------------------------------------------------------
# LLM backend (used by the RAG question-answering pipeline)
# LLM_BACKEND selects which client create_llm_client() builds: "yandex" or "local".
# ---------------------------------------------------------------------------
LLM_BACKEND=yandex

# Yandex Cloud (OpenAI-compatible endpoint)
YANDEX_API_KEY=your_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_MODEL=qwen3.6-35b-a3b
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Local OpenAI-compatible server (e.g. vLLM / llama.cpp / Ollama)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Keep at 0: with vLLM's hermes tool-call parser, Qwen2.5 reliably emits a
# well-formed <tool_call> tag at temperature=0 but not at higher values
# (observed empirically) - this affects the ReAct agent's tool-calling
# reliability, not plain text generation.
LOCAL_LLM_TEMPERATURE=0.0
# Raise this for reasoning-enabled backends (e.g. Qwen3.5) - they spend part
# of the budget on a reasoning block before the final answer, and the
# non-reasoning default (2000) can get exhausted before one is reached,
# raising "LLM returned an empty response".
LOCAL_LLM_MAX_TOKENS=8192
# app.py's context-usage progress bar (sidebar/under each answer) divides by
# this - not read from any API, so keep it in sync with whatever model
# LOCAL_LLM_MODEL actually points at.
LOCAL_LLM_CONTEXT_LENGTH=32768

# ---------------------------------------------------------------------------
# Retrieval embedding model (LanceDBRetriever / sentence-transformers).
# Also used to budget chunk sizes against the encoder's own token window
# (src/file_agent/chunking.py's get_embedding_tokenizer) - the two must stay
# in sync, which is why both read this same variable rather than each having
# their own. Leave unset to use the default
# (sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2).
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------------------------------------------------------------------------
# VLM (describes figures/diagrams in PDFs so they become searchable text).
# VLM_BACKEND selects the backend:
#   off     - disabled (default); parsing stays fully offline.
#   smolvlm - local SmolVLM-256M via transformers: no server, no API key,
#             CPU-friendly, ~500 MB one-time download. Cheapest working option.
#   openai  - any OpenAI-compatible vision endpoint (best quality):
#             local Ollama (VLM_BASE_URL=http://localhost:11434/v1,
#             VLM_MODEL=qwen2.5-vl:7b) or a cloud API.
# Cost controls: at most VLM_MAX_FIGURES largest figures per document are
# described; figures smaller than VLM_MIN_FIGURE_AREA (PDF points^2) are skipped.
# VLM_MAX_TOKENS (openai backend only, default 1500): raise this for
# reasoning-enabled backends (e.g. Qwen3.5) - they can spend the whole budget
# on a reasoning block before ever writing a final answer into `content`,
# same quirk as LOCAL_LLM_MAX_TOKENS above.
# ---------------------------------------------------------------------------
VLM_BACKEND=off
VLM_LOCAL_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=qwen2.5-vl:7b
VLM_API_KEY=dummy
VLM_MAX_TOKENS=1500
VLM_MAX_FIGURES=8
VLM_MIN_FIGURE_AREA=5000

# ---------------------------------------------------------------------------
# OCR (used by the parser for scanned/image PDF pages; auto-triggered per page).
# OCR_ENGINE: "easyocr" (default, reads Cyrillic + Latin, accurate but slower on
# CPU) or "rapidocr" (faster, offline, Latin/CJK only).
# OCR_LANGS: language codes for EasyOCR (default "ru,en").
# ---------------------------------------------------------------------------
OCR_ENGINE=easyocr
OCR_LANGS=ru,en

# ---------------------------------------------------------------------------
# Tracing (OpenTelemetry -> Jaeger; parsing/chunking/retrieval layers)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# ---------------------------------------------------------------------------
# ReAct agent (agent/loop.py)
# ---------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=10
SANDBOX_IMAGE=file-agent-sandbox:latest

# ---------------------------------------------------------------------------
# Langfuse (agent LLM-turn/tool-call tracing; self-hosted, own stack - see
# docker-compose.yml's file-agent-langfuse-* services). LANGFUSE_PUBLIC_KEY/
# LANGFUSE_SECRET_KEY come from the Langfuse web UI after first bring-up;
# leaving them unset makes agent tracing a silent no-op (e.g. in tests).
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3050

# Self-host infra secrets for the file-agent-langfuse-* compose services only
# (not read by the application code) - generate real random values, do not
# reuse these placeholders.
LANGFUSE_POSTGRES_PASSWORD=change_me
LANGFUSE_CLICKHOUSE_PASSWORD=change_me
LANGFUSE_REDIS_PASSWORD=change_me
LANGFUSE_S3_ACCESS_KEY=change_me
LANGFUSE_S3_SECRET_KEY=change_me
LANGFUSE_SALT=change_me
LANGFUSE_ENCRYPTION_KEY=change_me
LANGFUSE_NEXTAUTH_SECRET=change_me
