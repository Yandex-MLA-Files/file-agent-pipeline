# ---------------------------------------------------------------------------
# LLM backend (used by the RAG question-answering pipeline)
# LLM_BACKEND selects which client create_llm_client() builds: "yandex" or "local".
# ---------------------------------------------------------------------------
LLM_BACKEND=yandex

# Yandex Cloud (OpenAI-compatible endpoint)
YANDEX_API_KEY=your_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_MODEL=qwen3.6-35b-a3b
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Local OpenAI-compatible server (e.g. vLLM / llama.cpp / Ollama)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ---------------------------------------------------------------------------
# VLM backend (used by the parser to describe figures/diagrams in PDF/DOCX).
# Any OpenAI-compatible vision endpoint works (Ollama, vLLM, Yandex, ...).
# VLM is opt-in: it is only contacted when parse_file(..., enable_vlm=True).
# Example (local Ollama): VLM_BASE_URL=http://localhost:11434/v1, VLM_MODEL=qwen2.5-vl:7b
# ---------------------------------------------------------------------------
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=qwen2.5-vl:7b
VLM_API_KEY=dummy

# ---------------------------------------------------------------------------
# OCR (used by the parser for scanned/image PDF pages; auto-triggered per page).
# OCR_ENGINE: "easyocr" (default, reads Cyrillic + Latin, accurate but slower on
# CPU) or "rapidocr" (faster, offline, Latin/CJK only).
# OCR_LANGS: language codes for EasyOCR (default "ru,en").
# ---------------------------------------------------------------------------
OCR_ENGINE=easyocr
OCR_LANGS=ru,en
