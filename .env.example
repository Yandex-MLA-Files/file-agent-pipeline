# ---------------------------------------------------------------------------
# LLM backend (used by the RAG question-answering pipeline)
# LLM_BACKEND selects which client create_llm_client() builds: "yandex" or "local".
# ---------------------------------------------------------------------------
LLM_BACKEND=yandex

# Yandex Cloud (OpenAI-compatible endpoint)
YANDEX_API_KEY=your_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_MODEL=qwen3.6-35b-a3b
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Local OpenAI-compatible server (e.g. vLLM / llama.cpp / Ollama)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ---------------------------------------------------------------------------
# VLM (describes figures/diagrams and transcribes scanned pages).
# VLM_BACKEND selects the backend:
#   llm     - default: reuse the answering model's endpoint (LOCAL_LLM_BASE_URL /
#             LOCAL_LLM_MODEL). Works when that model is multimodal (Qwen3.5,
#             Qwen-VL): no second model to deploy. Thinking is off for vision
#             calls (VLM_ENABLE_THINKING=true to force it on).
#   openai  - a separate OpenAI-compatible vision endpoint (VLM_BASE_URL /
#             VLM_MODEL / VLM_API_KEY), e.g. Ollama qwen2.5-vl or a cloud API.
#   smolvlm - local SmolVLM-256M via transformers (no server, lowest quality).
#   off     - disabled; parsing stays fully offline.
# Cost controls: the largest figures of a document are described, by default a
# quarter of its page count (at least 8, at most 32); VLM_MAX_FIGURES pins a
# fixed number. PDF figures smaller than VLM_MIN_FIGURE_AREA (points^2) are
# skipped. VLM_OCR_CONCURRENCY page transcriptions run in parallel.
# ---------------------------------------------------------------------------
VLM_BACKEND=llm
# VLM_MAX_FIGURES=8
# VLM_OCR_CONCURRENCY=4
VLM_MIN_FIGURE_AREA=5000
VLM_MAX_TOKENS=1200
VLM_TIMEOUT_SECONDS=180
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_MODEL=qwen2.5-vl:7b
# VLM_API_KEY=dummy
# VLM_LOCAL_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct

# ---------------------------------------------------------------------------
# OCR for PDF pages without a text layer (decided per page automatically).
# OCR_ENGINE:
#   auto     - default. The multimodal model transcribes the rendered page
#              (keeps headings, lists, tables and formulas; measured character
#              error rate 0.11 against 0.31 for EasyOCR on scan-like pages, and
#              it does not degrade on skewed or noisy scans). Every transcript
#              is validated and a page the model fails on is re-read by
#              EasyOCR, so the result is never worse than classic OCR.
#   vlm      - the same without the local fallback.
#   easyocr  - classic engine inside Docling (Cyrillic + Latin), ~15x faster
#              per page, no endpoint needed, loses the layout.
#   rapidocr - classic engine, Latin/CJK, fastest.
#   off      - no OCR.
# OCR_LANGS: EasyOCR language codes. OCR_DPI: page render resolution (150).
# ---------------------------------------------------------------------------
OCR_ENGINE=auto
OCR_LANGS=ru,en
# PDF_ENRICHMENT: re-read formula and code regions of PDFs with Docling's
# enrichment models, so a formula is indexed as LaTeX instead of the glyph
# soup its text layer holds (default on; the model downloads once, ~400 MB).
# PDF_ENRICHMENT=on
# PDF_ENRICHMENT_ENGINE: who reads those regions.
#   auto    - the serving multimodal model when one is configured (2.6x faster
#             than Docling's own model on a formula-dense lecture, better on
#             formulas containing Russian words, and needs no local GPU),
#             Docling's CodeFormulaV2 otherwise;
#   vlm     - always the serving model;  docling - always the local model;
#   off     - same as PDF_ENRICHMENT=off.
# PDF_ENRICHMENT_ENGINE=auto
# PDF_ENRICHMENT_CONCURRENCY: formula requests in flight (default 8; 16 is
# ~27 % faster and correspondingly harder on a shared endpoint).
# PDF_ENRICHMENT_CONCURRENCY=8
# PDF_ENRICHMENT_DPI: crop resolution for those requests (default 200).
# PDF_ENRICHMENT_CACHE: directory for transcripts, keyed by the crop's pixels
# (default ~/.cache/file_agent/formula_enrichment; "off" disables it).
# Re-ingesting the same corpus then costs 3 s instead of 184 s.
# PDF_ENRICHMENT_CACHE=off
# PDF_ENRICHMENT_BATCH: regions per forward pass for the *docling* engine.
# "auto" (default) sizes it from the memory free on the card, because the
# stage hides an out-of-memory and then returns *no* formulas at all.
# PDF_ENRICHMENT_BATCH=auto
# FORMULA_INDEXING: "inline" (default) embeds a standalone formula with the
# prose around it; "context" keeps it out of the embedded text and shows it
# only through the parent passage. Measured: "context" costs formula retrieval
# (hit@5 1.000 -> 0.567) and does not help prose retrieval.
# FORMULA_INDEXING=inline
# PDF_TABLE_VLM: auto (re-read degenerate tables with the VLM), off, always.
# PDF_TABLE_VLM=auto

# ---------------------------------------------------------------------------
# Parsing, chunking and retrieval.
# PARSER_PROFILE: "structured" (default: format-aware parsers with headings,
#   lists, tables, figures) or "legacy" (original flat parsers).
# CHUNKING_STRATEGY: "structured" (default: heading-path breadcrumbs, typed
#   splitting, parent windows) or "legacy" (original chunker).
# CHUNK_TARGET_TOKENS: token budget per chunk when the encoder allows more
#   (default 384; capped by the encoder window).
# EMBEDDING_MODEL: sentence-transformers model for dense retrieval (default
#   BAAI/bge-m3; the previous encoder is
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2).
# RERANKER_MODEL: cross-encoder that re-scores the top hybrid hits (recommended:
#   BAAI/bge-reranker-v2-m3, ~2.3 GB, fp16 on GPU); leave empty to disable.
#   RERANKER_CANDIDATES: hits to re-score (default max(6*top_k, 30) — the
#     passage that answers a differently worded question often sits at rank
#     20-40 of the first stage, and the cross-encoder can only promote what it
#     is shown). RERANKER_BATCH_SIZE (32) and RERANKER_MAX_LENGTH (1024 tokens
#     per query+passage pair) bound the cost of one pass. RERANKER_BLEND (0..1,
#     default 0) mixes the first-stage rank back in; 0 lets the cross-encoder
#     decide alone.
# MULTI_QUERY: search with several formulations of the question and fuse the
#   lists (reciprocal-rank fusion). "on"/"off" (default off). The formulations
#   come from the answering model and are cached on disk (MULTI_QUERY_CACHE,
#   default ~/.cache/file_agent/multi_query, "off" to disable), so a repeated
#   question costs nothing. One extra model call per new question (~1 s).
#   MULTI_QUERY_MODE: "paraphrase" (N rewordings, the code default), "hyde"
#     (one hypothetical answer passage — measured best over a multi-document
#     index: +0.02 recall, +0.04 union recall, at one model call), "mixed"
#     (N-1 rewordings + 1 passage).
#   MULTI_QUERY_COUNT: formulations to add in paraphrase/mixed mode (default
#     3, at most 8); hyde always adds exactly one passage.
#   MULTI_QUERY_WEIGHT: RRF weight of a generated formulation against the
#     original question's 1.0 (default 1.0).
# BM25_LEMMATIZE: "auto" (default: lemmatise Russian for the lexical index with
#   pymorphy3 when it is installed), "on", "off" (ё-folding and stemming only).
#   The original text is untouched; a second index column holds the lexical
#   form and a query matches through either.
# RETRIEVAL_UNIQUE_PASSAGES: fill top-k with distinct parent passages rather
#   than chunks (default true) — the prompt shows the passage, so two chunks of
#   one section would be read once and waste a slot.
# RETRIEVAL_DIVERSIFY_DOCS: keep the best hit of every indexed document in the
#   top-k before filling by score (default true; helps multi-file questions).
# TABLE_ROW_RECORDS: index every table row additionally as "Column: value"
#   (default true; this is what answers "which row has X" on wide tables).
# CHUNK_SEMANTIC_SPLIT: cut long unstructured prose at topic boundaries found
#   with the encoder instead of at the token budget (default false, costs an
#   extra encoder pass).
# QA_PROMPT: "v3" (default: grounded, complete answers), "v2" (same plus a
#   "Источники: file, page" footer) or "v1" (original short prompt).
# ---------------------------------------------------------------------------
PARSER_PROFILE=structured
CHUNKING_STRATEGY=structured
CHUNK_TARGET_TOKENS=384
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_CANDIDATES=30
# RERANKER_BLEND=0
MULTI_QUERY=on
MULTI_QUERY_MODE=hyde
# MULTI_QUERY_COUNT=3
BM25_LEMMATIZE=auto
RETRIEVAL_UNIQUE_PASSAGES=true
RETRIEVAL_DIVERSIFY_DOCS=true
TABLE_ROW_RECORDS=true
# CHUNK_SEMANTIC_SPLIT=false
QA_PROMPT=v3

# ---------------------------------------------------------------------------
# Multi-step agent (answer_mode=agent in the batch CLI, "Agent" in the app).
# AGENT_VERIFY runs an editor pass over the draft against its cited passages;
# AGENT_CITED_SOURCES_ONLY exports only cited passages as contexts;
# AGENT_FALLBACK_TO_RAG answers with single-pass RAG when the loop fails.
# AGENT_TRACE_DIR appends one JSON line per question (steps, observations,
# citations) to <dir>/agent_trace.jsonl.
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_VERIFY=true
AGENT_CITED_SOURCES_ONLY=true
AGENT_FALLBACK_TO_RAG=true
# AGENT_MAX_PARALLEL_ACTIONS=3
# AGENT_MAX_OBSERVATION_CHARS=14000
# AGENT_TRACE_DIR=logs/agent

# ---------------------------------------------------------------------------
# Tracing (OpenTelemetry -> Jaeger)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# ---------------------------------------------------------------------------
# Generation settings shared by every LLM backend.
# LLM_ENABLE_THINKING controls reasoning models served with a reasoning parser
# (Qwen3.5 on vLLM): unset = server default, false = fast direct answers
# (recommended for batch evaluation), true = force thinking.
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
# LLM_ENABLE_THINKING=false
