JUDGE_BASE_URL=https://api.your-provider.example/v1
JUDGE_API_KEY=
JUDGE_MODEL=your-model-name

# Optional. answer_relevancy (ResponseRelevancy) generates candidate
# questions from the response and cosine-compares them against the actual
# question -- needs an embeddings model, not just the judge LLM above. Runs
# LOCALLY (sentence-transformers, no API call, no extra cost) -- downloads
# from HuggingFace Hub on first use if not already cached. Default below is
# multilingual (matches Russian eval data); override if not applicable.
JUDGE_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Optional. Cost log for RagasJudge's LLM calls -- one JSON line per
# evaluate() run. Defaults shown are Yandex Cloud AI Studio's RUB/1K-token
# rate as of 2026-07-20; override if the model/provider changes.
JUDGE_USAGE_LOG_PATH=logs/usage_log.jsonl
JUDGE_PRICE_PER_1K_INPUT_TOKENS=0.3
JUDGE_PRICE_PER_1K_OUTPUT_TOKENS=0.5
JUDGE_PRICE_PER_1K_CACHED_TOKENS=0.075

# Optional. Per-row judge trace log -- one JSON line per evaluated example:
# question, judged answer, per-metric verdict, and the full reasoning trace
# (every intermediate judge prompt/response). One FILE per evaluate() call
# (this path is a base name, a timestamp is inserted before the extension)
# so a single run's trace can be opened/grepped/deleted on its own.
JUDGE_TRACE_LOG_PATH=logs/judge_trace_log.jsonl

# Optional. Max concurrent LLM calls ragas makes during evaluate(). Default
# (8) stays under Yandex Cloud AI Studio's account quota of 10 concurrent
# generation sessions -- raise only if your quota is higher.
JUDGE_MAX_CONCURRENCY=8

# Optional. Per-call timeout (seconds) and retry attempts ragas allows
# before giving up on a single LLM call and returning NaN for that
# row/metric. Widened past ragas' own defaults (timeout=180, max_retries=10)
# because answer_relevancy (ResponseRelevancy, strictness=3) asks Yandex for
# 3 completions in one request -- Yandex only ever returns 1, and hit
# TimeoutError on 2/4 rows of a smoketest under the tighter defaults.
JUDGE_TIMEOUT=300
JUDGE_MAX_RETRIES=15
