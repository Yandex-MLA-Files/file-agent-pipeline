JUDGE_BASE_URL=https://api.your-provider.example/v1
JUDGE_API_KEY=
JUDGE_MODEL=your-model-name

# Optional dataset-specific regex. When set, report.json includes separate
# means for answerable and "no answer in source" examples.
JUDGE_NEGATIVE_EXAMPLE_PATTERN=

JUDGE_EMBEDDING_MODEL=intfloat/multilingual-e5-small


# Leave empty to store logs inside the CLI --out directory.
JUDGE_USAGE_LOG_PATH=
JUDGE_PRICE_PER_1K_INPUT_TOKENS=0.3
JUDGE_PRICE_PER_1K_OUTPUT_TOKENS=0.5
JUDGE_PRICE_PER_1K_CACHED_TOKENS=0.075


JUDGE_TRACE_LOG_PATH=


JUDGE_MAX_CONCURRENCY=8

# Whole-metric timeout used by Ragas, and a tighter timeout for each HTTP
# request made inside a metric.
JUDGE_TIMEOUT=300
JUDGE_REQUEST_TIMEOUT=180

# Bound one judge completion. Leave JUDGE_REASONING_MODE empty to keep the
# provider/model default for the primary high-quality attempt. If a metric
# returns an empty/non-numeric result, retry only that metric using the
# fallback mode. Yandex AI Studio accepts DISABLED through its native SDK, but
# its OpenAI-compatible /v1 endpoint currently rejects the reasoning_mode field.
# In that case the evaluator automatically performs a bounded provider-default
# retry instead of sending a request that is guaranteed to fail with HTTP 400.
JUDGE_MAX_TOKENS=8192
JUDGE_REASONING_MODE=
JUDGE_FALLBACK_REASONING_MODE=DISABLED

JUDGE_MAX_RETRIES=3
